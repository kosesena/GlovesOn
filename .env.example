# AssemblyAI API anahtarin (https://www.assemblyai.com/app/api-keys)
ASSEMBLYAI_API_KEY=

# Gateway'in PUBLIC HTTPS adresi.
# AssemblyAI HTTP tools localhost'a BAGLANAMAZ - tunel veya deploy sart.
# ornek: https://gloveson.trycloudflare.com   veya   https://gloveson.onrender.com
GATEWAY_PUBLIC_URL=

# Tool cagrilarini dogrulamak icin paylasilan gizli anahtar (kendin uydur)
TOOL_SHARED_SECRET=degistir-beni-lutfen

# publish.py calistiktan sonra buraya donen agent id'yi yaz
AGENT_ID=

# 5) Gercek bir S/4HANA'ya baglanmak icin. Bos birakilirsa gateway kendi
#    icindeki mock S/4HANA'ya baglanir - ayni OData sozlesmesi, ayni CSRF
#    el sikismasi. "Gercege gecis tek bir base URL" cumlesi tam olarak bu
#    satiri doldurmak demek.
#    ornek: https://my123456.s4hana.cloud.sap
SAP_BASE_URL=
SAP_TIMEOUT_SECONDS=8

# --- Veritabani (ZORUNLU) ----------------------------------------------------
# Mock S/4HANA verisini burada tutuyor. Eskiden yan yana duran bir SQLite
# dosyasiydi; sunucusuz bir dagitimda kalici disk olmadigi icin tasindi
# (docs/adr/0005). Yerelde de gerekli - cevrimdisi calisma yok.
# Neon'un POOLED adresini kullan: sunucusuz ortamda ornek sayisi bizim
# kontrolumuzde degil, havuzsuz adres baglanti limitine carpar.
DATABASE_URL=

# --- Dagitim icin istege bagli -----------------------------------------------
# Vercel'de bunlar panodan verilir, dosyadan degil. BOS BIRAKMAK ILE SILMEK
# ayni sey degil: bir dagitim panosu bu dosyayi okuyup butun isimleri bos
# degerlerle olusturuyor, ve bos bir degisken tanimsiz sayilmiyordu - ilk
# Vercel dagitimini bu dusurdu. Kod artik bosu tanimsiz kabul ediyor, ama
# burada gereksiz isim tutmamak yine de daha temiz.

# Mock S/4HANA'ya gercek bir soket uzerinden gitmek icin. Bos birakilirsa
# mock ayni uygulamada, ASGI tasiyicisiyla cagriliyor (docs/adr/0005).
MOCK_SAP_BASE_URL=

GLOVESON_ENABLE_RESET=1

# Saatte kac ses oturumu token'i dagitilsin. Ses oturumu saniye basina
# faturalanir ve token ucu bilerek kimliksiz - anahtar tarayiciya hic gitmesin
# diye. Sabit bir adreste bu ucun bulunabilir olmasi fatura demek.
VOICE_TOKEN_MAX_PER_HOUR=40
