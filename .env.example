# Your AssemblyAI API key (https://www.assemblyai.com/app/api-keys)
ASSEMBLYAI_API_KEY=

# The gateway's own public HTTPS address.
# Nothing dials in any more (docs/adr/0006): tool calls come back through the
# browser, so no tunnel is needed and localhost is fine to develop against.
# This is still READ AND VALIDATED on every session - it must parse as https
# with a hostname, or /api/voice-token answers 500 and there is no voice at all.
# LEAVING IT EMPTY IS THE FAILURE THAT TOOK PRODUCTION DOWN ON 9 SEPTEMBER.
# e.g.: https://gloveson.vercel.app
GATEWAY_PUBLIC_URL=

# Shared secret that authenticates tool calls (invent your own)
TOOL_SHARED_SECRET=change-me-please

# Legacy. Browser sessions send their configuration inline and create no agent,
# so nothing reads this any more; publish.py survives for the diagnostic path.
AGENT_ID=

# To connect to a real S/4HANA. Left empty, the gateway talks to its own
# mock S/4HANA - same OData contract, same CSRF handshake. Moving to the real
# thing is configuration rather than code, and it is these two lines: where to
# go, and what to prove.
#
# SAP's own sandbox for these released APIs, free with an api.sap.com account:
#   SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
# A real tenant instead:
#   SAP_BASE_URL=https://my123456.s4hana.cloud.sap
SAP_BASE_URL=
# Sent as the APIKey header, which is what SAP's API gateway asks for. Without
# it the CSRF fetch is rejected before it can hand back a token, and the error
# says CSRF when it means authentication. A PRODUCTIVE tenant should not use a
# service credential at all - see docs/clean-core.md on principal propagation.
SAP_API_KEY=
SAP_TIMEOUT_SECONDS=8

# --- Database (REQUIRED) -----------------------------------------------------
# The mock S/4HANA keeps its data here. It used to be a SQLite file next to
# the code; it moved because a serverless deployment has no persistent disk
# (docs/adr/0005). Needed locally too - there is no offline mode.
# Use Neon's POOLED endpoint: in a serverless environment the number of
# instances is not under our control, and the unpooled endpoint runs into
# the connection limit.
DATABASE_URL=

# --- Optional, for deployments -----------------------------------------------
# On Vercel these come from the dashboard, not from a file. LEAVING EMPTY and
# DELETING are not the same thing: a deployment dashboard reads this file and
# creates every name it finds with an empty value, and an empty variable did
# not count as undefined - that took down the first Vercel deployment. The
# code now treats empty as undefined, but not keeping needless names here is
# cleaner still.

# To reach the mock S/4HANA over a real socket. Left empty, the mock is
# called in the same app over an ASGI transport (docs/adr/0005).
MOCK_SAP_BASE_URL=

GLOVESON_ENABLE_RESET=1

# How many voice-session tokens to hand out per hour. A voice session is
# billed per second and the token endpoint is deliberately unauthenticated -
# so the key never reaches the browser. On a fixed address, that endpoint
# being findable means a bill.
VOICE_TOKEN_MAX_PER_HOUR=40
