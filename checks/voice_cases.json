{
  "language": "en",
  "purpose": "Human or simulated caller script; expected outcomes are assertions, never agent context or consent.",
  "cases": [
    {
      "id": "paused-material",
      "say": [
        "Check stock for material four seven",
        "[pause 1.5 seconds]",
        "one one"
      ],
      "expect": {
        "tool": "get_stock",
        "arguments": {
          "material": "4711"
        },
        "writes": 0
      }
    },
    {
      "id": "paired-material",
      "say": [
        "Where are the bearings, material fifty one hundred?"
      ],
      "expect": {
        "tool": "get_stock",
        "arguments": {
          "material": "5100"
        },
        "writes": 0
      }
    },
    {
      "id": "quantity-correction",
      "say": [
        "Receive twenty pieces of material forty seven eleven",
        "[wait for readback]",
        "Actually twelve, not twenty",
        "[wait for corrected readback]",
        "Confirm"
      ],
      "expect": {
        "fresh_draft_after_correction": true,
        "write_quantity": 12,
        "writes": 1
      }
    },
    {
      "id": "decline",
      "say": [
        "Receive twenty pieces of material forty seven eleven",
        "[wait for readback]",
        "No, cancel that"
      ],
      "expect": {
        "writes": 0
      }
    },
    {
      "id": "incomplete-order",
      "say": [
        "Check purchase order forty five",
        "[pause 2 seconds]"
      ],
      "expect": {
        "clarification": true,
        "writes": 0
      }
    },
    {
      "id": "unknown-order",
      "say": [
        "Check purchase order nine nine nine nine nine nine nine nine nine nine"
      ],
      "expect": {
        "not_found": true,
        "writes": 0
      }
    },
    {
      "id": "explanation-only",
      "say": [
        "What is invoice verification?"
      ],
      "expect": {
        "tool": "search_mm_knowledge",
        "writes": 0,
        "prepares": 0
      }
    },
    {
      "id": "wrong-kind-of-id",
      "say": [
        "Check purchase order forty seven eleven"
      ],
      "expect": {
        "clarification": true,
        "writes": 0
      }
    },
    {
      "id": "ambiguous-consent",
      "say": [
        "Receive twenty pieces of material forty seven eleven",
        "[wait for readback]",
        "Yes but make that twelve"
      ],
      "expect": {
        "fresh_draft_after_correction": true,
        "writes": 0
      }
    },
    {
      "id": "network-during-post",
      "say": [
        "Receive twenty pieces of material forty seven eleven",
        "[wait for readback]",
        "Confirm",
        "[disconnect transport during tool response]"
      ],
      "expect": {
        "max_writes": 1,
        "automatic_write_retry": false
      }
    },
    {
      "id": "damaged-delivery",
      "say": [
        "Three hydraulic hoses arrived damaged.",
        "Save an incident note.",
        "[wait for complete note readback]",
        "Confirm"
      ],
      "expect": {
        "tool": "save_note",
        "erp_writes": 0,
        "communication_records": 1,
        "simulated": true
      }
    },
    {
      "id": "dropped-item",
      "say": [
        "I dropped two ball bearings and they broke.",
        "Draft an email to the warehouse supervisor.",
        "[wait for readback]",
        "No, cancel that."
      ],
      "expect": {
        "tool": "prepare_email",
        "writes": 0,
        "no_scrap_claim": true
      }
    },
    {
      "id": "mock-call",
      "say": [
        "Call the warehouse supervisor.",
        "[wait for recipient and demo call readback]",
        "Confirm"
      ],
      "expect": {
        "tool": "place_call",
        "communication_records": 1,
        "real_calls": 0,
        "no_invented_answer": true
      }
    },
    {
      "id": "email-correction",
      "say": [
        "Email Alex that three hoses arrived damaged.",
        "[wait for readback]",
        "Actually two hoses, not three.",
        "[wait for new readback]",
        "Confirm"
      ],
      "expect": {
        "tool": "send_email",
        "fresh_draft_after_correction": true,
        "communication_records": 1,
        "real_emails": 0
      }
    }
  ]
}
